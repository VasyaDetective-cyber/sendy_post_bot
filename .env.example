# Токен від @BotFather
BOT_TOKEN=123456:ABC-DEF
# Telegram ID власника (Super Admin). Дізнатись можна в @userinfobot
SUPER_ADMIN_ID=123456789
# SQLite (за замовчуванням) або PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sendy
DATABASE_URL=sqlite+aiosqlite:///data/sendy.db
# Часовий пояс для відкладених постів
TIMEZONE=Europe/Kyiv
# Як часто планувальник перевіряє чергу (сек)
SCHEDULER_INTERVAL_SEC=20
LOG_LEVEL=INFO
